# Imagem autocontida: constroi o site e serve com nginx.
# Nao depende de volume, git nem rede -- e o que permite subir no Portainer
# importando um unico arquivo.

FROM squidfunk/mkdocs-material:9 AS build
WORKDIR /docs
COPY . .
RUN mkdocs build --strict

FROM nginx:alpine
COPY --from=build /docs/site /usr/share/nginx/html

# nginx escuta na 8000 para casar com o mapeamento 8080:8000
RUN sed -i 's/listen       80;/listen       8000;/' /etc/nginx/conf.d/default.conf \
 && printf 'types { application/pdf pdf; model/vnd.usdz+zip usdz; }\n' > /etc/nginx/conf.d/tipos.conf

EXPOSE 8000
